# ============================================================
#  КИС «Учёт клиентов» — конфигурация запуска.
#  Скопируйте этот файл в .env и при необходимости поправьте.
#  Файл .env в .gitignore: секреты не должны попадать в репозиторий.
# ============================================================

# Подключение к PostgreSQL.
# Формат postgresql:// также подходит — драйвер asyncpg подставится автоматически.
DATABASE_URL=postgresql://crm_user:crm_password@127.0.0.1:5432/crm_db

# Отдельная база для интеграционных тестов (создаётся scripts\pg-setup.ps1).
TEST_DATABASE_URL=postgresql://crm_user:crm_password@127.0.0.1:5432/crm_test

# Ключ подписи JWT. Возьмите не менее 32 символов, например:
#   powershell -c "[guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')"
JWT_SECRET=change-me-to-a-long-random-string

# Срок жизни токена доступа: 900 (секунды), 45m, 12h или 1d.
JWT_EXPIRES_IN=12h

# Адрес, который слушает backend (используется при запуске python -m app.main).
HOST=127.0.0.1
PORT=8000

# Разрешённые источники для CORS. При запуске через Vite-прокси не задействуются,
# но нужны, если фронтенд обращается к API напрямую (VITE_API_URL).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Учётная запись менеджера, которую создаст python -m app.seed
SEED_MANAGER_LOGIN=manager
SEED_MANAGER_PASSWORD=manager123
SEED_MANAGER_NAME=Иванова Ирина Ивановна
